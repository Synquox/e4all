{
  "schemaVersion": 1,
  "id": "e4all",
  "version": "${version}",
  "name": "e4all",
  "description": "The e4mc fork that lets anyone join your LAN world from anywhere, even with offline accounts.",
  "authors": [
    "JustPixel"
  ],
  "contributors": [
    "skyevg (Original e4mc infrastructure)"
  ],
  "contact": {
    "sources": "https://github.com/Synquox/e4all"
  },
  "license": "MIT",
  "icon": "e4all_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "link.e4all.fabric.E4allClientFabric"
    ],
    "voicechat": [
      "link.e4all.voice.E4allVoicechatPlugin"
    ],
    "modmenu": [
      "link.e4all.fabric.E4allModMenu"
    ]
  },
  "mixins": [
    "e4all.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": ">=1.18"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/McAy9u56NC"
      }
    }
  },
  "provides": [
    "e4mc_minecraft",
    "e4mc"
  ]
}
